{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "functions": {
    "api/mdt.js": {
      "includeFiles": "mdt/**"
    }
  },
  "routes": [
    { "src": "/mdt", "dest": "/api/mdt?path=index.html" },
    { "src": "/mdt/", "dest": "/api/mdt?path=index.html" },
    { "src": "/mdt/(.*)", "dest": "/api/mdt?path=$1" },
    { "handle": "filesystem" }
  ]
}
