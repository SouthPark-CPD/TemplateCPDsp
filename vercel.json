{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "functions": {
    "api/mdt.js": {
      "includeFiles": "mdt/**"
    },
    "api/academy-admin.js": {
      "includeFiles": "academy-admin/**"
    }
  },
  "routes": [
    { "src": "/api/academy-admin-auth/(discord|callback|session|logout)", "dest": "/api/academy-router?action=$1" },
    { "src": "/api/academy-admin-data/agent/save", "dest": "/api/academy-router?action=agent-save" },
    { "src": "/api/academy-admin-data/training-overview", "dest": "/api/academy-router?action=training-overview" },
    { "src": "/api/academy-admin-data/activity", "dest": "/api/academy-router?action=activity" },
    { "src": "/api/academy-admin-data/dashboard", "dest": "/api/academy-router?action=dashboard" },
    { "src": "/api/academy-admin-data/training-templates", "dest": "/api/academy-router?action=training-templates" },
    { "src": "/api/academy-admin-data/training-template/save", "dest": "/api/academy-router?action=training-template-save" },
    { "src": "/api/academy-admin-data/training-template/toggle", "dest": "/api/academy-router?action=training-template-toggle" },
    { "src": "/api/academy-admin-data/training/update", "dest": "/api/academy-router?action=training-update" },
    { "src": "/api/academy-admin-data/training/archive", "dest": "/api/academy-router?action=training-archive" },
    { "src": "/api/academy-admin-data/training/create", "dest": "/api/academy-router?action=training-create" },
    { "src": "/api/academy-admin-data/recruitment/decision", "dest": "/api/academy-router?action=recruitment-decision" },
    { "src": "/api/academy-admin-data/recruitment/tickets", "dest": "/api/academy-router?action=recruitment-tickets" },
    { "src": "/api/academy-admin-data/recruitment/ticket", "dest": "/api/academy-router?action=recruitment-ticket" },
    { "src": "/api/academy-ticket-sync", "dest": "/api/academy-router?action=ticket-sync" },
    { "src": "/api/academy-admin-data/agents", "dest": "/api/academy-router?action=agents" },
    { "src": "/api/academy-admin-data/agent", "dest": "/api/academy-router?action=agent" },
    { "src": "/api/database-check", "dest": "/api/academy-router?action=database-check" },
    { "src": "/academy-admin", "dest": "/api/academy-admin?path=index.html" },
    { "src": "/academy-admin/", "dest": "/api/academy-admin?path=index.html" },
    { "src": "/academy-admin/(.*)", "dest": "/api/academy-admin?path=$1" },
    { "src": "/mdt", "dest": "/api/mdt?path=index.html" },
    { "src": "/mdt/", "dest": "/api/mdt?path=index.html" },
    { "src": "/mdt/(.*)", "dest": "/api/mdt?path=$1" },
    { "handle": "filesystem" }
  ]
}
